	"Build RST Tasks": {
		"prefix": "rst-tasks",
		"scope": "json",
		"body": [
			"{",
			"    \"version\": \"2.0.0\",",
			"    \"tasks\": [",
			"        {",
			"            \"label\": \"Build rst file\",",
			"            \"type\": \"shell\",",
			"            \"command\": \"..\\\\..\\\\..\\\\..\\\\RstBuilder\\\\RstBuilder.exe\",",
			"            \"args\": [",
			"                \"${1:ParamsTest}.json\",",
			"                \"${1:ParamsTest}.lua\",",
			"                \"-s\",",
			"                \"1.0\",",
			"                \"-o\",",
			"                \"${1:ParamsTest}.rst\"",
			"            ],",
			"            \"group\": {",
			"                \"kind\": \"build\",",
			"                \"isDefault\": true",
			"            }",
			"        },",
			"        {",
			"            \"type\": \"shell\",",
			"            \"label\": \"Load rst file\",",
			"            \"command\": \"..\\\\..\\\\..\\\\..\\\\STDLLoader\\\\STDLLoader.exe\",",
			"            \"args\": [",
			"                \"${1:ParamsTest}.rst\",",
			"                \"${2:Equipment}\"",
			"            ],",
			"            \"group\": \"test\"",
			"        },",
			"        {",
			"            \"type\": \"shell\",",
			"            \"label\": \"StdlJsonEditor\",",
			"            \"command\": \"..\\\\..\\\\..\\\\..\\\\StdlJsonEditor\\\\StdlJsonEditor.exe\",",
			"            \"args\": [",
			"                \"${1:ParamsTest}.json\"",
			"            ],",
			"            \"group\": \"test\"",
			"        },",
			"        {",
			"            \"type\": \"shell\",",
			"            \"label\": \"JsonToLuaParams\",",
			"            \"command\": \"..\\\\..\\\\..\\\\..\\\\JsonToLuaParams\\\\JsonToLuaParams.exe\",",
			"            \"args\": [",
			"                \"${1:ParamsTest}.json\",",
			"                \"${1:ParamsTest}.lua\"",
			"            ],",
			"            \"group\": \"test\"",
			"        }",
			"    ]",
			"}"
		],
		"description": "Generate RST build tasks configuration"
	},
