	//---------------------------------------------------------------------------
	"STDL_scheme": {
		"prefix": "STDL scheme",
		"scope": "json",
		"body": [
			"{",
			"\t\"metadata\": {",
			"\t\t\"defaultName\": \"${1:name}\",",
			"\t\t\"description\": \"${2:description}\",",
			"\t\t\"version\": \"$3.$4.$5\",",
			"\t\t\"author\": \"${6:author}\"",
			"\t},",
			"\t\"styleParameters\": [",
			"\t\t$7",
			"\t],",
			"\t\"ports\": [",
			"\t\t$8",
			"\t]",
			"}"
		]
	},
	"ParameterGroup": {
		"prefix": "StyleParameters.ParameterGroup",
		"scope": "json",
		"body": [
			"{",
			"\t\"name\": \"${1:GroupName}\",",
			"\t\"text\": \"${2:Text}\",",
			"\t\"params\": [",
			"\t\t$3",
			"\t]",
			"}"
		]
	},
